{
  "mcpServers": {
    "github": {
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-github@latest"],
      "env": {
        "GITHUB_PERSONAL_ACCESS_TOKEN": "ghp_FAKE_NOT_A_REAL_TOKEN"
      }
    },
    "postgres": {
      "command": "uvx",
      "args": ["mcp-server-postgres", "--dsn", "postgres://admin@localhost/prod"],
      "env": {
        "DATABASE_URL": "postgres://admin:FAKE@localhost/prod",
        "PGPASSWORD": "FAKE"
      }
    },
    "filesystem": {
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-filesystem", "C:\\"]
    },
    "remote-notion": {
      "type": "http",
      "url": "https://mcp.notion.com/mcp"
    }
  }
}
