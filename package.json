{
  "name": "mcp-doctor",
  "version": "0.1.0",
  "description": "Audits the MCP servers your AI can actually reach.",
  "type": "module",
  "bin": {
    "mcp-doctor": "./dist/index.js",
    "mcp-doctor-server": "./dist/server.js"
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.test.json",
    "test": "tsx --test test/*.test.ts",
    "dev": "tsx src/index.ts",
    "audit": "tsx src/index.ts audit",
    "serve": "tsx src/server.ts",
    "selftest": "tsx src/index.ts audit --spawn fixtures/selftest"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "jsonc-parser": "^3.3.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  },
  "engines": {
    "node": ">=20"
  }
}
