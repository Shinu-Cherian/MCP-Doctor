{
  "name": "@tracepoint/mcp-doctor",
  "version": "0.3.1",
  "description": "Security auditor for MCP servers. Finds tool descriptions carrying hidden instructions, annotations that contradict their own schema, over-shared credentials, and pairs of tools that together form a path off your machine. Runs entirely offline.",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "security",
    "security-scanner",
    "audit",
    "ai-agents",
    "llm",
    "prompt-injection",
    "tool-poisoning",
    "cli"
  ],
  "homepage": "https://github.com/Shinu-Cherian/MCP-Doctor#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Shinu-Cherian/MCP-Doctor.git"
  },
  "bugs": {
    "url": "https://github.com/Shinu-Cherian/MCP-Doctor/issues"
  },
  "license": "MIT",
  "author": "Shinu Cherian",
  "type": "module",
  "bin": {
    "mcp-doctor": "./dist/index.js"
  },
  "files": [
    "dist",
    "!dist/**/*.map",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.test.json",
    "test": "node scripts/run-tests.mjs",
    "dev": "tsx src/index.ts",
    "audit": "tsx src/index.ts audit",
    "serve": "tsx src/index.ts serve",
    "selftest": "tsx src/index.ts audit --spawn --no-live --no-logs fixtures/selftest",
    "prepublishOnly": "npm run typecheck && npm test && npm run build"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "jsonc-parser": "^3.3.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  },
  "engines": {
    "node": ">=20"
  }
}
